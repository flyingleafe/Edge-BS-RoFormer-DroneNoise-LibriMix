# Copy to .env and fill in. Never commit .env. `direnv`/`python-dotenv` loads it.

# Cloudflare R2 — dload and s3fs (ArtifactStore) read these as S3 credentials.
#   Create an R2 API token (Object Read & Write, scoped to bucket) at
#   https://dash.cloudflare.com/<acct>/r2/api-tokens
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Your R2 account id (used by src/training/artifacts.py to build the endpoint URL).
R2_ACCOUNT_ID=
# R2 ignores standard AWS region names; this must be literally "auto".
AWS_DEFAULT_REGION=auto

# Weights & Biases
WANDB_API_KEY=

# Online-mixing dataloader packed PCM16 source cache.
# Set this to a large/fast local partition on GPU machines.
ONLINE_MIX_SOURCE_CACHE_DIR=.cache/online_mix_sources
