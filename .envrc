# Save NODE_PATH before nix-direnv (use flake) overwrites it with just the
# nix store paths from nodejs/pyright setup hooks.
_nix_old_node_path="${NODE_PATH:-}"

if has nix; then
  use flake .
else
  source .venv/bin/activate
fi

# Restore the original NODE_PATH, prepending it so user-global paths take
# precedence over nix store paths but the nix paths are still available.
if [[ -n "$_nix_old_node_path" ]]; then
  export NODE_PATH="${_nix_old_node_path}:${NODE_PATH}"
fi
unset _nix_old_node_path

# Load .env (WANDB_API_KEY, AWS_*, R2_ACCOUNT_ID, AWS_DEFAULT_REGION) into
# the shell environment so `dload`, `aws`, etc. see them.
if [[ -f .env ]]; then
  dotenv .env
fi
