if has nix; then
  use flake .
else
  source .venv/bin/activate
fi

# Load .env (WANDB_API_KEY, AWS_*, R2_ACCOUNT_ID, AWS_DEFAULT_REGION) into
# the shell environment so `dvc`, `aws`, etc. see them.
if [[ -f .env ]]; then
  dotenv .env
fi

# postdoc default target host. Override per-command with `--host`.
export POSTDOC_HOST=vast-server
