# Copy to ~/.sky/ssh_node_pools.yaml then run `sky ssh up`.
#
# The key (`vast-server`) is the pool name. It must match the host alias in
# your ~/.ssh/config so that `ssh vast-server` already works.
#
# Override the pool name with `postdoc submit --pool <name>` or env var
# POSTDOC_SSH_POOL.
vast-server:
  hosts:
    - vast-server        # resolved via ~/.ssh/config
