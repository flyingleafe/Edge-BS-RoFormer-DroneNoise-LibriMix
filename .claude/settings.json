{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/ruff-pyright.sh\"",
            "timeout": 120,
            "statusMessage": "ruff + pyright"
          }
        ]
      }
    ]
  }
}
