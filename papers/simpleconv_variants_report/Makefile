# Makefile for SimpleConv Variants Report
# Usage: make pdf     — regenerate figures and compile LaTeX
#        make clean   — remove generated PDFs and auxiliary files
#        make figures — regenerate figures only

# Paths are relative to this Makefile's location
LATEX     := latexmk -pdf -interaction=nonstopmode -halt-on-error
PYTHON    := python3

# Project root is two levels up from this directory
PROJ_ROOT := ../..
SCRIPT    := scripts/generate_variant_report_figures.py
EVAL_DATA := $(wildcard $(PROJ_ROOT)/results/rps_eval_full_sequence/*/metrics.json) \
             $(wildcard $(PROJ_ROOT)/results/rps_eval_single_rotor/*/metrics.json)

FIG_DIR   := figures
FIGS      := fig_leaderboard_validation \
             fig_pareto_params_r2 \
             fig_fullsequence_comparison \
             fig_fullsequence_inflight_mse_bar \
             fig_fullsequence_simple_conv \
             fig_fullsequence_simple_conv_bigru \
             fig_fullsequence_simple_conv_bigru_v2 \
             fig_individual_motor_mse_bar \
             fig_single_rotor_allmotors_comparison \
             fig_allmotors_mse_bar

FIGURE_PDFS := $(patsubst %,$(FIG_DIR)/%.pdf,$(FIGS))
FIGURE_PNGS := $(patsubst %,$(FIG_DIR)/%.png,$(FIGS))

.PHONY: all pdf figures clean distclean

all: pdf

pdf: simpleconv_variants_report.pdf

simpleconv_variants_report.pdf: main.tex $(FIGURE_PDFS)
	@echo "=== Compiling LaTeX ==="
	$(LATEX) main.tex
	@cp main.pdf simpleconv_variants_report.pdf

# All figures are generated by a single Python script
$(FIGURE_PDFS) $(FIGURE_PNGS): $(PROJ_ROOT)/$(SCRIPT) $(EVAL_DATA)
	@echo "=== Regenerating figures ==="
	cd $(PROJ_ROOT) && $(PYTHON) $(SCRIPT)

# Convenience target: regenerate figures without compiling LaTeX
figures: $(FIGURE_PDFS)

clean:
	rm -f *.aux *.log *.out *.toc *.synctex.gz *.fdb_latexmk *.fls *.bbl *.blg
	rm -f main.pdf simpleconv_variants_report.pdf

distclean: clean
	rm -f $(FIGURE_PDFS) $(FIGURE_PNGS)
